# ---------------------------------------------------------------------------
# RinseOps environment. Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (docker compose exposes it on 5433)
DATABASE_URL="postgresql://rinseops:rinseops@localhost:5433/rinseops?schema=public"
# Used by the API integration tests (created automatically by docker compose)
TEST_DATABASE_URL="postgresql://rinseops:rinseops@localhost:5433/rinseops_test?schema=public"

# Redis (provisioned for future background jobs; not required by the MVP)
REDIS_URL="redis://localhost:6380"

# API
API_PORT=4000
# Comma-separated origins allowed to call the API with credentials
WEB_ORIGIN="http://localhost:3000"
# Session lifetime in days
SESSION_TTL_DAYS=14
# Set to true behind HTTPS so cookies get the Secure flag. With COOKIE_SECURE=true the
# API also refuses to start without a strong MOBILE_JWT_SECRET (even if NODE_ENV is unset).
COOKIE_SECURE=false
# Reverse proxies allowed to report the client IP (X-Forwarded-For): "loopback" (default,
# proxy on the same host), a hop count such as 1, or comma-separated proxy IPs/CIDRs.
# Client IPs drive login rate limiting and audit logs; set this to match the deployment.
TRUST_PROXY=loopback

# Web (Next.js) — where the Next server proxies /api/* requests
API_INTERNAL_URL="http://localhost:4000"

# Native app (Android/iOS) authentication: Bearer access tokens + rotating refresh tokens.
# REQUIRED in production: a random secret, e.g. `openssl rand -base64 48`. Production refuses
# to start if it is missing, shorter than 32 characters, low-entropy, or the dev value.
# Rotating it only invalidates current access tokens; the apps refresh automatically.
# Leave empty in development to use a built-in dev-only value.
MOBILE_JWT_SECRET=
MOBILE_ACCESS_TTL_MINUTES=15
MOBILE_REFRESH_TTL_DAYS=30
